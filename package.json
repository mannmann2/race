{
  "name": "race-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs --production",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p '*_test.py'",
    "test:browser": "python3 tests/browser.py",
    "refresh": "node scripts/refresh-all.mjs",
    "refresh:itra": "node scripts/refresh-all.mjs --itra-only",
    "refresh:marathons": "node scripts/refresh-all.mjs --worldsmarathons-only",
    "compose": "node scripts/compose-catalog.mjs",
    "enrich": "python3 scripts/enrich.py",
    "refresh:map": "node scripts/refresh-map.mjs",
    "deploy": "node scripts/deploy.mjs",
    "rollback": "node scripts/rollback.mjs",
    "health": "node scripts/healthcheck.mjs",
    "backup": "node scripts/backup.mjs",
    "test:ci": "node scripts/test-ci.mjs",
    "test:launch": "python3 tests/launch-browser.py",
    "prune": "node scripts/prune.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
