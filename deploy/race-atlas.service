[Unit]
Description=Race Atlas at race.slopmaxx.ing (port 4173)
After=network.target

[Service]
Type=simple
User=race-atlas
Group=race-atlas
WorkingDirectory=/srv/race
ExecStart=/opt/race/node/bin/node /srv/race/scripts/serve.mjs --production
Environment=HOST=127.0.0.1
Environment=PORT=4173
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/root/race:/srv/race
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
UMask=0027
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
